rules_version = '2';

// DeeCee Company OS — server-side permissions.
// Roles (a person can have several): admin, sales, drawing, stores (material & dispatch),
//        projects (installation manager), service, accounts, technician (site team), client.
// Technicians can only see records stamped with THEIR team (staff/{id}.teamId).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && profile().active != false; }
    // A login can have several roles (roles: [...]); older logins have a single 'role'
    function myRoles() { return profile().get('roles', [profile().role]); }
    function isAdmin() { return active() && myRoles().hasAny(['admin']); }
    function hasRole(roles) { return active() && myRoles().hasAny(['admin'].concat(roles)); }
    function isOffice() { return active() && myRoles().hasAny(['admin', 'sales', 'drawing', 'stores', 'projects', 'service', 'accounts']); }
    function isTech() { return active() && myRoles().hasAny(['technician']) && !isOffice(); }
    function isClient() { return active() && myRoles().hasAny(['client']) && !isOffice(); }
    function isStaff() { return isOffice() || isTech(); }
    function myTeam() { return get(/databases/$(database)/documents/staff/$(profile().staffId)).data.teamId; }
    function teamDoc() { return isTech() && resource.data.teamId != null && resource.data.teamId == myTeam(); }
    function ownsDoc() { return isClient() && resource.data.clientId == profile().clientId; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // ---- First-time setup: the first person to claim it becomes Admin (only once) ----
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone()
        && existsAfter(userPath()) && getAfter(userPath()).data.role == 'admin';
    }

    // ---- Logins ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        // Sales / Accounts / Service can create CLIENT portal logins only
        || (hasRole(['sales', 'accounts', 'service']) && request.resource.data.role == 'client'
            && request.resource.data.get('roles', ['client']) == ['client'] && request.resource.data.clientId is string)
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
            && !setupDone() && existsAfter(/databases/$(database)/documents/meta/setup));
      // Admin can edit anyone, but cannot remove their own admin role or disable themselves
      allow update: if isAdmin() && !(uid == request.auth.uid
        && (!request.resource.data.get('roles', [request.resource.data.role]).hasAny(['admin']) || request.resource.data.active == false));
      // Admin may remove CLIENT portal logins (e.g. test data reset); staff logins are never deleted
      allow delete: if isAdmin() && resource.data.role == 'client';
    }

    match /settings/{id} { allow read: if active(); allow write: if isAdmin(); }
    match /counters/{id} { allow read, write: if active(); }
    match /audit/{id} { allow read: if isAdmin(); allow create: if isStaff(); allow update: if false; allow delete: if isAdmin(); }
    match /payroll/{id} { allow read, write: if hasRole(['accounts']); }
    // Internal costing per client tab — never visible to clients, technicians or other teams
    match /costings/{id} { allow read, write: if hasRole(['sales', 'accounts']); }

    // ---- People & teams ----
    match /staff/{staffId} {
      allow read: if isOffice() || (isTech() && profile().staffId == staffId);
      allow create: if hasRole(['accounts']);
      // Installation & service managers may only move people between teams
      allow update: if hasRole(['accounts'])
        || (hasRole(['projects', 'service']) && onlyChanges(['teamId', 'updatedAt', 'updatedBy']));
      allow delete: if false;
    }
    match /teams/{id} { allow read: if isStaff(); allow write: if hasRole(['projects', 'service', 'accounts']); }
    match /attendance/{id} {
      allow read: if isOffice() || (isTech() && resource.data.staffId == profile().staffId);
      allow write: if hasRole(['accounts'])
        || (isStaff() && request.resource.data.staffId == profile().staffId)
        // a manager approving leave marks those days for their own team member
        || (isOffice() && request.resource.data.get('leaveType', null) is string
            && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.get('reportsTo', '') == profile().staffId);
    }

    // ---- Office-only records ----
    match /clients/{id} {
      allow read: if isOffice();
      allow create, update: if hasRole(['sales', 'projects', 'service', 'accounts']);
      allow delete: if isAdmin();
    }
    match /items/{id} { allow read: if isOffice(); allow write: if hasRole(['stores']); }
    match /stockMoves/{id} { allow read: if isOffice(); allow create: if hasRole(['stores']); allow update: if false; allow delete: if isAdmin(); }
    match /vendors/{id} { allow read: if isOffice(); allow write: if hasRole(['stores']); }
    match /purchaseOrders/{id} { allow read: if isOffice(); allow write: if hasRole(['stores']); }
    match /dispatches/{id} { allow read: if isOffice(); allow write: if hasRole(['stores']); }

    // ---- Client tabs / orders ----
    match /projects/{id} {
      allow read: if isOffice() || teamDoc() || ownsDoc();
      allow create: if hasRole(['sales']);
      allow update: if isOffice()
        || (teamDoc() && onlyChanges(['site', 'install', 'material', 'diary', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin();
    }

    // ---- Drawings & documents (stored in pieces) ----
    match /files/{fileId} {
      allow read: if isOffice() || teamDoc() || (ownsDoc() && resource.data.visibleToClient == true);
      allow create: if isOffice() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOffice();

      match /chunks/{part} {
        function file() { return get(/databases/$(database)/documents/files/$(fileId)).data; }
        allow read: if isOffice()
          || (isTech() && file().teamId != null && file().teamId == myTeam())
          || (isClient() && file().clientId == profile().clientId && file().visibleToClient == true);
        allow create: if isOffice() && file().createdBy == request.auth.uid && request.resource.data.d.size() <= 800000;
        allow delete: if isOffice();
        allow update: if false;
      }
    }

    // Tasks between staff
    match /tasks/{id} {
      allow read, create, update: if isOffice();
      allow delete: if isAdmin();
    }
    // Leave: anyone applies for themselves; Accounts / Admin decide
    match /leaves/{id} {
      function myReport() { return isOffice() && resource.data.get('managerId', null) != null && resource.data.managerId == profile().staffId; }
      allow read: if hasRole(['accounts']) || (isStaff() && resource.data.staffId == profile().staffId) || myReport();
      allow create: if isStaff() && request.resource.data.staffId == profile().staffId && request.resource.data.status == 'Pending';
      allow update: if hasRole(['accounts'])
        || (myReport() && onlyChanges(['status', 'decidedBy', 'decidedAt', 'note', 'updatedAt', 'updatedBy']));
      allow delete: if hasRole(['accounts']);
    }
    match /payslips/{id} { allow read, write: if hasRole(['accounts']); }

    // Daily site diary from the site team's phones
    match /diary/{id} {
      allow read: if isOffice() || teamDoc();
      allow create, update: if isOffice() || (isTech() && request.resource.data.teamId == myTeam());
      allow delete: if isAdmin();
    }

    match /photos/{id} {
      allow read: if isOffice() || teamDoc() || (ownsDoc() && resource.data.visibleToClient == true);
      allow create: if (isOffice() || (isTech() && request.resource.data.teamId == myTeam()))
        && request.resource.data.data.size() < 900000;
      allow update: if isOffice();
      allow delete: if hasRole(['projects', 'service', 'sales']) || (isTech() && resource.data.createdBy == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if isOffice() || teamDoc() || (ownsDoc() && resource.data.visibleToClient == true);
      allow create: if isOffice()
        || (isTech() && request.resource.data.text.size() < 3000
            && (request.resource.data.projectId == null
                || get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.teamId == myTeam()));
      allow update: if isAdmin() || (isOffice() && onlyChanges(['teamId', 'teamVisible']));
      allow delete: if isAdmin();
    }

    // ---- Service ----
    match /visits/{id} {
      allow read: if isOffice() || teamDoc() || ownsDoc();
      allow create: if isOffice();
      allow update: if isOffice()
        || (teamDoc() && onlyChanges(['status', 'startedAt', 'doneAt', 'doneBy', 'checklist', 'notes', 'partsUsed', 'customerName', 'signature', 'startLoc', 'doneLoc', 'survey', 'updatedAt', 'updatedBy']))
        || (ownsDoc() && onlyChanges(['rating', 'feedback', 'ratedAt', 'updatedAt', 'updatedBy']));
      allow delete: if hasRole(['service', 'projects']);
    }
    match /complaints/{id} {
      allow read: if isOffice() || teamDoc() || ownsDoc();
      allow create: if isOffice()
        || (isClient() && request.resource.data.clientId == profile().clientId && request.resource.data.status == 'Open');
      allow update: if isOffice()
        || (teamDoc() && onlyChanges(['status', 'resolution', 'resolvedAt', 'updatedAt', 'updatedBy']))
        || (ownsDoc() && onlyChanges(['rating', 'feedback', 'ratedAt', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin();
    }
    match /amcs/{id} {
      allow read: if isOffice() || ownsDoc();
      allow create, update: if hasRole(['service', 'projects']);
      allow delete: if isAdmin();
    }

    // ---- Sent by clients from the portal: payment details, drawing approval, site ready, messages, AMC renewal ----
    match /clientRequests/{id} {
      allow read: if isOffice() || ownsDoc();
      allow create: if isClient() && request.resource.data.clientId == profile().clientId
        && request.resource.data.status == 'New'
        && request.resource.data.type in ['payment', 'drawing', 'site', 'message', 'amc', 'quote']
        && request.resource.data.get('images', []).size() <= 3;
      allow update: if isOffice();
      allow delete: if isAdmin();
    }

    // ---- Money ----
    match /invoices/{id} {
      allow read: if isOffice() || ownsDoc();
      allow create: if hasRole(['accounts', 'service']);
      allow update: if hasRole(['accounts', 'service'])
        || (hasRole(['stores']) && onlyChanges(['paid', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin(); // Admin only, for test/duplicate invoices — real ones should be cancelled
    }
    match /payments/{id} {
      allow read: if isOffice() || ownsDoc();
      allow create: if hasRole(['accounts', 'stores']);
      // Accounts can revoke (reverse) a payment; only Admin can change or delete it otherwise
      allow update: if isAdmin()
        || (hasRole(['accounts']) && request.resource.data.status == 'Reversed'
            && onlyChanges(['status', 'reversedReason', 'reversedAt', 'reversedBy', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin();
    }

    // ---- Client photo gallery: the ONLY records anyone can read without logging in ----
    // Public = visible photos, their full-size copies, the gallery settings, and a client selection opened by its exact link.
    // Sales / Admin manage it. Nothing about clients, sites or staff is stored on these records.
    function galleryEditor() { return hasRole(['sales']); }
    match /gallery/{id} {
      allow read: if resource.data.hidden == false || isOffice();
      allow create, update: if galleryEditor()
        && request.resource.data.hidden is bool
        && request.resource.data.code is string
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 200000;
      allow delete: if galleryEditor();
    }
    match /galleryFull/{id} {
      allow read: if isOffice() || get(/databases/$(database)/documents/gallery/$(id)).data.hidden == false;
      allow create: if galleryEditor() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if galleryEditor();
    }
    match /gallerySets/{id} {
      allow get: if true;           // a client opens their selection by its link
      allow list: if isOffice();    // but nobody outside can list all selections
      allow create, update: if galleryEditor() && request.resource.data.ids is list && request.resource.data.ids.size() <= 300;
      allow delete: if galleryEditor();
    }
    match /galleryConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
